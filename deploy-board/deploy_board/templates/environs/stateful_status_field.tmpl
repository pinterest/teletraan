{% load utils %}
{% get_pincompute_exception_form_link as exception_form_link %}
{% if envName %}{% is_stateless_exception_approved envName as exception_approved %}{% endif %}
{% if exception_form_link %}
<div class="form-group">
    <label class="col-md-2 control-label">Stateful Status</label>
    <div class="col-md-10">
        <label class="radio-inline">
            <input type="radio" name="statefulStatus" value="STATEFUL" required="required"> Stateful
        </label>
        <label class="radio-inline">
            <input type="radio" name="statefulStatus" value="STATELESS" required="required"> Stateless
        </label>
        <span class="help-block">
            STATELESS - hosts can be rotated without data loss or other effects.
            STATEFUL - hosts cannot be rotated automatically without data loss or other effects (i.e. loss of information in the ram, storage, etc.).
        </span>
        {% if exception_approved %}
        <div class="alert alert-info stateless-exception-warning" hidden="true">
            Environment {{ envName }} has an approved PinCompute exception for stateless stages.
        </div>
        {% else %}
        <div class="alert alert-danger stateless-exception-warning" hidden="true"{% if envName %} data-block-submit="true"{% endif %}>
            New stateless services must launch in PinCompute. Creating a stateless stage requires an approved
            <a href="{{ exception_form_link }}" target="_blank">PinCompute exception</a>.
            Once approved, the environment is added to the allowlist and you can retry creating the stage.
        </div>
        {% endif %}
    </div>
</div>
<script>
    $(function() {
        $('input[name="statefulStatus"]').change(function () {
            var $form = $(this).closest('form');
            var isStateless = $form.find('input[name="statefulStatus"]:checked').val() == 'STATELESS';
            var $warning = $form.find('.stateless-exception-warning');
            $warning.prop('hidden', !isStateless);
            $form.find('button[type="submit"]').prop('disabled', isStateless && $warning.is('[data-block-submit]'));
        });
    });
</script>
{% endif %}
